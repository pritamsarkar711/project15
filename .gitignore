/node_modules
# composer.json + composer.lock ARE tracked so Hostinger's Git auto-deploy
# runs `composer install` with the CORRECT dependencies (laravel/framework, etc.).
# This generates a valid autoloader with Illuminate\ mappings.
#
# Previously, an empty/wrong composer.json on an old arena branch caused
# Hostinger's auto-composer to strip all framework mappings, leading to
# "Class Illuminate\Foundation\Application not found".
#
# vendor/ is still committed as a fallback in case composer install fails.
# The committed bootstrap/autoload_backup/ also provides autoloader repair.
#
# app/Application.php overrides getNamespace() so the app boots without
# reading composer.json at runtime (Laravel's only runtime use of it).

# package.json + package-lock.json are NOT tracked (kept in .npm-backup/
# for local dev) to avoid Hostinger's npm auto-detect. They are not needed
# at runtime since public/build/ is committed.
/package.json
/package-lock.json
/storage/framework/cache/data/*
!storage/framework/cache/data/.gitkeep
/storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
/storage/framework/views/*
!storage/framework/views/.gitkeep
/storage/logs/*.log
!storage/logs/.gitkeep
/storage/app/public/*
!storage/app/public/.gitkeep
!storage/app/.gitkeep
/public/storage
/public/hot
/.env
/.env.local
/.env.production
npm-local-*
composer.phar
.phpunit.result.cache
*.log
__pycache__/
*.py[cod]
.DS_Store
.idea
.vscode
*.swp
*.swo

# Local SQLite database (production uses MySQL — see install.php)
database/*.sqlite
database/*.sqlite-journal

# Build artifacts ARE committed so the repo is runnable without `npm run build`.
# vendor/ IS committed so the repo is deployable without `composer install`.
