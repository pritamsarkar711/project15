# Huvanti on Hostinger when public_html is the project root
# -----------------------------------------------------------------------------
# The application code lives above public/ because Hostinger's Git deployment
# checks out the repository directly into public_html. Only install.php and the
# temporary emergency doctor are allowed to execute from that private root.
# Everything else is forwarded into public/.

Options -Indexes
DirectoryIndex index.php index.html

# Fail closed rather than exposing the repository if rewriting is unavailable.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Standalone bootstrap/recovery endpoints. Delete after installation.
    # deploy.php MUST be listed here: without the exemption the root rewrite
    # forwards /deploy.php into public/ where it does not exist, so opening
    # https://your-domain/deploy.php returned a 404 and the deploy steps
    # (cache clear + migrations) could never run.
    RewriteRule ^(?:install|doctor|deploy)\.php$ - [L]

    # Per-directory rewrites can run again after the internal public/ rewrite.
    # Stop here so /foo never becomes /public/public/... (an HTTP 500 loop).
    # Use L rather than END so public/.htaccess can still route Laravel URLs.
    RewriteRule ^public(?:/|$) - [L]

    # Do NOT exempt existing project-root files. That would expose files such as
    # storage/logs/laravel.log, source code, manifests and backup configuration.
    # Static assets are served from public/ on the next rewrite pass.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# A unique, cache-independent signal that the corrected deployment is active.
<IfModule mod_headers.c>
    Header always set X-Huvanti-Deploy "2026-08-25-panel-no-radius-v37"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Defense in depth if rewriting is disabled or misconfigured.
<FilesMatch "(^\.|\.env|\.log$|composer\.(json|lock)$|package\.(json|lock)$|vite\.config\.js$|phpunit\.xml$)">
    Require all denied
</FilesMatch>
