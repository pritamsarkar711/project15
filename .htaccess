# Huvanti on Hostinger when public_html is the project root
# -----------------------------------------------------------------------------
# The application code lives above public/ because Hostinger's Git deployment
# checks out the repository directly into public_html. NOTHING from the
# private root is executable — every request is forwarded into public/.

Options -Indexes
DirectoryIndex index.php index.html

# Fail closed rather than exposing the repository if rewriting is unavailable.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # -----------------------------------------------------------------
    # Canonical host & scheme — ONE 301 hop (SEO fix).
    # 1) http -> https, but ONLY when the request truly arrived over
    #    plain http. Behind Hostinger's CDN the origin sees http, so the
    #    X-Forwarded-Proto header decides — checking both prevents a
    #    redirect loop on the edge.
    # 2) www -> non-www: www.huvanti.com used to answer 200 with its own
    #    self-canonical tags (full duplicate content); it must 301 away.
    # -----------------------------------------------------------------
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} ^(www\.)?huvanti\.com$ [NC]
    RewriteRule ^ https://huvanti.com%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^www\.huvanti\.com$ [NC]
    RewriteRule ^ https://huvanti.com%{REQUEST_URI} [R=301,L,NE]

    # -----------------------------------------------------------------
    # Strip trailing slashes at the EDGE, before the internal public/
    # rewrite. public/.htaccess also strips them, but it runs AFTER that
    # rewrite and its per-directory prefix turned "/blog/" into a 301 to
    # "/public/blog" — which then 404'd. Every trailing-slash link to the
    # site was effectively broken (Ahrefs "3XX redirect" findings).
    # NOTE: deliberately NO "!-d" (not-a-directory) condition. A stray
    # directory on the hosting docroot (e.g. an old "blog/" folder that
    # git never tracked) made !-d fail and silently disabled this rule
    # for exactly that path, re-creating the /public/blog redirect.
    # Directory URLs are not part of this site's public URL space, and
    # Options -Indexes already prevents directory listings.
    # -----------------------------------------------------------------
    RewriteCond %{REQUEST_URI} ^(.+)/$
    RewriteRule ^ %1 [R=301,L,NE]

    # Per-directory rewrites can run again after the internal public/ rewrite.
    # Stop here so /foo never becomes /public/public/... (an HTTP 500 loop).
    # Use L rather than END so public/.htaccess can still route Laravel URLs.
    RewriteRule ^public(?:/|$) - [L]

    # Do NOT exempt existing project-root files. That would expose files such as
    # storage/logs/laravel.log, source code, manifests and backup configuration.
    # Static assets are served from public/ on the next rewrite pass.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# A unique, cache-independent signal that the corrected deployment is active.
<IfModule mod_headers.c>
    Header always set X-Huvanti-Deploy "v52-2026-08-31-feed-inspired-polish"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Defense in depth if rewriting is disabled or misconfigured.
<FilesMatch "(^\.|\.env|\.log$|composer\.(json|lock)$|package\.(json|lock)$|vite\.config\.js$|phpunit\.xml$)">
    Require all denied
</FilesMatch>
